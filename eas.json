{
  "cli": {
    "version": ">= 25.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment":"development",
      "env":{
        "APP_VARIANT":"development"
      }
    },
   
    "staging": {
      "distribution":"internal",
      "environment":"preview",
      "env": {
        "APP_VARIANT":"staging"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment":"production",
      "env":{
        "APP_VARIANT":"production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
